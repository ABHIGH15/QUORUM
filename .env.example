# ==============================================================================
# Quorum Environment Configuration (.env.example)
# ==============================================================================

# PostgreSQL Database (Required in production / Render)
# Use Supabase Session Pooler (port 5432) or local Postgres:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=""

# In-Memory DB Safeguard (Local dev only, strictly blocked in production)
ALLOW_IN_MEMORY_DB="false"

# PayPal Sandbox Developer Credentials
# From https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# PayPal Webhook ID (obtained after registering webhook URL in Developer Dashboard)
# Event selection: "All Events"
# Webhook URL: https://<your-app>.onrender.com/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=""

# PayPal Sandbox Personal Accounts for Vendor Payouts
# Default fallback recipient if individual vendor emails are not specified:
PAYPAL_RECIPIENT_EMAIL=""
# Or per-vendor emails:
PAYPAL_VENDOR_PROJECTOR_EMAIL=""
PAYPAL_VENDOR_SCREEN_EMAIL=""
PAYPAL_VENDOR_AUDIO_EMAIL=""

# Google Gemini API
# From https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Security & Secrets
SESSION_SECRET=""
DEMO_RESET_SECRET="quorum_demo_reset_secret_key"
DEMO_MODE="true"
FAILURE_INJECTION="false"

# Base URL (for webhooks & scenario verification)
BASE_URL="http://localhost:3000"
